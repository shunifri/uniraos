# 本地开发环境配置 - 连接 Docker 基础设施
NODE_ENV=development
PORT=3000

# MySQL (端口 3307)
MYSQL_PRIMARY_HOST=localhost
MYSQL_PRIMARY_PORT=3307
MYSQL_USER=raos
MYSQL_PASSWORD=raospassword
MYSQL_DATABASE=raos
MYSQL_CONN_LIMIT=20

# Redis (端口 6380)
REDIS_HOSTS=localhost:6380
REDIS_PASSWORD=
REDIS_KEY_PREFIX=raos:

# Qdrant (端口 6334)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6335

# RabbitMQ (端口 5673)
RABBITMQ_URL=amqp://raos:raospassword@localhost:5673

# JWT
JWT_SECRET=dev-secret-key-change-in-production

# Log
LOG_LEVEL=debug

USE_MYSQL=true
