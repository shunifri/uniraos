# 本地开发环境配置 - 连接 Docker 基础设施
NODE_ENV=development
PORT=3000

# MySQL (端口 3307)

# Redis (端口 6380)
REDIS_HOSTS=localhost:6380
REDIS_PASSWORD=
REDIS_KEY_PREFIX=raos:

# Qdrant (端口 6334)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6335

# RabbitMQ (端口 5673)
RABBITMQ_URL=amqp://raos:raospassword@localhost:5673

# JWT
JWT_SECRET=dev-secret-key-change-in-production

# Log
LOG_LEVEL=debug

USE_MYSQL=true

# Neo4j 配置 (端口 7687 用于 Bolt, 7474 用于 HTTP)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=raospassword
NEO4J_DATABASE=raos
NEO4J_AUTH=neo4j/raospassword
NEO4J_PAGE_CACHE=512M
NEO4J_HEAP_INIT=512M
NEO4J_HEAP_MAX=1G

# 知识图谱存储后端: mysql 或 neo4j (默认 mysql)
GRAPH_STORE_BACKEND=neo4j
