# RAOS Docker 基础设施配置 - MySQL 模式

# ============================================
# MySQL 数据库 (Docker: raos-mysql-primary)
# ============================================
MYSQL_PRIMARY_HOST=localhost
MYSQL_PRIMARY_PORT=3307
MYSQL_USER=raos
MYSQL_PASSWORD=raospassword
MYSQL_DATABASE=raos
MYSQL_CONN_LIMIT=20

# ============================================
# Qdrant 向量数据库 (Docker: raos-qdrant)
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=kb_chunks

# ============================================
# Redis 缓存 (Docker: raos-redis)
# ============================================
REDIS_HOSTS=localhost:6380
REDIS_KEY_PREFIX=raos:

# ============================================
# RabbitMQ 消息队列 (Docker: raos-rabbitmq)
# ============================================
RABBITMQ_URL=amqp://localhost:5673

# ============================================
# 数据库模式 (sqlite|mysql)
# ============================================
USE_MYSQL=true
