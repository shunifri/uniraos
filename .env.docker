# Docker 基础设施配置
USE_MYSQL=true
MYSQL_PRIMARY_HOST=localhost
MYSQL_PRIMARY_PORT=3306
MYSQL_USER=raos
MYSQL_PASSWORD=raospassword
MYSQL_DATABASE=raos
MYSQL_CONN_LIMIT=20

# Redis (Docker)
REDIS_HOSTS=localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=raos:

# Qdrant 向量数据库 (Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# RabbitMQ (Docker)
RABBITMQ_URL=amqp://raos:raospassword@localhost:5672

# 端口
PORT=3000
