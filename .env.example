# ============================================
# RAOS Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Required: strong secret for JWT signing (min 32 random chars)
JWT_SECRET=__REPLACE_IN_PRODUCTION__

# ============================================
# Docker Deployment
# ============================================
# Database backend: mysql (default for Docker) or sqlite (local dev)
USE_MYSQL=true
# Docker image tag for SWR deployment
IMAGE_TAG=latest

# ============================================
# MySQL Configuration
# ============================================
MYSQL_PRIMARY_HOST=localhost
MYSQL_PRIMARY_PORT=3306
MYSQL_USER=raos
# Required: strong MySQL root password (do not use default)
MYSQL_ROOT_PASSWORD=__REPLACE_IN_PRODUCTION__
# Required: strong MySQL application password (do not use default)
MYSQL_PASSWORD=__REPLACE_IN_PRODUCTION__
MYSQL_DATABASE=raos
MYSQL_CONN_LIMIT=20
# P2 修复：从库连接池大小（默认 30）
MYSQL_REPLICA_CONN_LIMIT=30
# P2 修复：连接池获取超时(ms) / 连接超时(ms) / 队列限制 / keepAlive 延迟(ms)
MYSQL_ACQUIRE_TIMEOUT=60000
MYSQL_CONNECT_TIMEOUT=10000
MYSQL_QUEUE_LIMIT=0
MYSQL_KEEP_ALIVE_DELAY=10000

# Read replicas (comma-separated host:port)
MYSQL_REPLICA_HOSTS=localhost:3307
MYSQL_REPLICA_PORT=3306

# ============================================
# SQLite Configuration (P2 修复：pragma 配置化)
# ============================================
SQLITE_CACHE_SIZE=-64000
SQLITE_BUSY_TIMEOUT=5000
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL

# ============================================
# Skill Database Pool (P2 修复：技能 DB 连接池)
# ============================================
SKILL_DB_CONN_LIMIT=10
SKILL_DB_IDLE_TIMEOUT_MS=300000

# ============================================
# Redis Configuration
# ============================================
# Single node: localhost:6379
# Cluster: node1:6379,node2:6379,node3:6379
REDIS_HOSTS=localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=raos:

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ============================================
# RabbitMQ Configuration
# ============================================
# Required: RabbitMQ credentials (update password before use)
RABBITMQ_URL=amqp://raos:__REPLACE_IN_PRODUCTION__@localhost:5672
RABBITMQ_USER=raos
# Required: strong RabbitMQ password
RABBITMQ_PASS=__REPLACE_IN_PRODUCTION__

# ============================================
# MinIO / S3 Configuration
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=raos
# Required: strong MinIO root password
MINIO_PASSWORD=__REPLACE_IN_PRODUCTION__
MINIO_BUCKET=raos-files

# ============================================
# LLM Provider Configuration
# ============================================
# 可选：首次启动后也可在系统设置 → LLM 配置中填写
# 如需通过环境变量预配置，取消下方注释并填写真实 key
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=

# Embedding (optional, defaults to LLM key)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ============================================
# Neo4j (Optional)
# ============================================
# Neo4j 认证（格式: neo4j/<password>），仅在使用图数据库时需要
NEO4J_AUTH=neo4j/__REPLACE_IN_PRODUCTION__

# ============================================
# Grafana (Optional)
# ============================================
# Grafana 管理员账号（使用监控功能时需要）
GRAFANA_USER=admin
GRAFANA_PASSWORD=__REPLACE_IN_PRODUCTION__

# ============================================
# Document Mind (Optional)
# ============================================
# 优先使用 DOCMIND_ACCESS_KEY_ID / DOCMIND_ACCESS_KEY_SECRET（覆盖配置文件）
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=
DOCUMENT_MIND_ENDPOINT=https://your-docmind-endpoint
DOCUMENT_MIND_API_KEY=your-docmind-key

# ============================================
# Federation (Optional)
# ============================================
FEDERATION_KEY=

# ============================================
# CORS / Security
# ============================================
ALLOWED_ORIGINS=http://localhost

# ============================================
# Feature Flags
# ============================================
ENABLE_ASYNC_LLM=true
ENABLE_DOC_PARSER_QUEUE=true
CACHE_QUERY_RESULTS=true
QUERY_CACHE_TTL=60

# ============================================
# Docker Secrets Support (P2)
# 任何密码/密钥类配置都支持 _FILE 后缀，
# 指向容器内 secret 文件路径，优先级高于明文环境变量
# 例如: MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
# ============================================
# MYSQL_PASSWORD_FILE=
# REDIS_PASSWORD_FILE=
# QDRANT_API_KEY_FILE=
# MINIO_PASSWORD_FILE=
# RABBITMQ_PASS_FILE=
# LLM_API_KEY_FILE=
