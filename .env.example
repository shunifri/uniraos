# =============================================================================
# RAOS 部署环境变量模板
# 复制为 .env.prod 并填实际值, 千万不要提交 .env.prod 到 git
# =============================================================================

# ----- MySQL -----
# 强密码 (>=16 字符, 数字+大小写+符号)
MYSQL_ROOT_PASSWORD=change_me_please_use_a_strong_password
MYSQL_USER=raos
MYSQL_PASSWORD=change_me_too
MYSQL_CONN_LIMIT=20

# ----- Redis -----
REDIS_PASSWORD=change_me_redis

# ----- RabbitMQ -----
RABBITMQ_USER=raos
RABBITMQ_PASS=change_me_rabbitmq

# ----- MinIO -----
MINIO_USER=raos_minio_root
MINIO_PASSWORD=change_me_minio_at_least_8_chars

# ----- Neo4j -----
NEO4J_AUTH=neo4j/change_me_neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_PAGE_CACHE=512M
NEO4J_HEAP_INIT=512M
NEO4J_HEAP_MAX=1G

# ----- 应用 -----
# JWT 签名密钥 (>=32 字符随机, 用 openssl rand -base64 32 生成)
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long_xxxxxxxxxxx
ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

# ----- LLM (可选, 也可以在系统设置里配置) -----
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1

# ----- Grafana (可选, 启用 monitoring profile 时必须) -----
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana

# ----- 部署 -----
# 镜像 tag (CI build 出来的版本号)
IMAGE_TAG=latest
# 知识图谱后端: mysql 或 neo4j
GRAPH_STORE_BACKEND=mysql

# ----- 日志级别 -----
LOG_LEVEL=info

# ----- 文件上传 -----
# 单文件最大 MB, 默认 200. 之前是 50, 用户的 18MB 真实 docx + 1-2 个 PDF 经常超.
# 超过返 413 + {"code":"FILE_TOO_LARGE", "maxSizeMB":...}
UPLOAD_MAX_FILE_SIZE_MB=200
