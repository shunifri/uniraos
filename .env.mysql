# RAOS 正式环境配置 - MySQL + Redis + Qdrant

# MySQL 主库 (Docker)
MYSQL_PRIMARY_HOST=localhost
MYSQL_PRIMARY_PORT=3307
MYSQL_USER=raos
MYSQL_PASSWORD=raospassword
MYSQL_DATABASE=raos
MYSQL_CONN_LIMIT=20

# Qdrant 向量数据库 (Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Redis 缓存 (Docker)
REDIS_HOSTS=localhost:6380
REDIS_KEY_PREFIX=raos:

# RabbitMQ (Docker)
RABBITMQ_URL=amqp://localhost:5673

# 禁用 SQLite 模式
USE_MYSQL=true
