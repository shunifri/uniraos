  "description": "Recursive Agent Operating System",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp -r src/ui dist/ui",
    "build:full": "cd web && npm run build && cd .. && tsc && cp -r src/ui dist/ui",
