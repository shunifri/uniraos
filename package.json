{
  "name": "raos",
  "version": "1.0.0",
  "description": "Recursive Agent Operating System",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && rm -rf dist/ui && cp -r src/ui dist/ui",
    "build:full": "cd web && npm run build && cd .. && tsc && rm -rf dist/ui && cp -r src/ui dist/ui",
    "build:ui": "cd web && npm run build && cd .. && rm -rf dist/ui && cp -r src/ui dist/ui",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "worker:start": "node dist/workers/index.js",
    "db:migrate": "tsx src/server/migration-runner.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run tests/memory/knowledge-graph/ --no-file-parallelism && vitest run --exclude tests/memory/knowledge-graph/",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && cd web && tsc --noEmit",
    "security-audit": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "agent",
    "skill",
    "recursive",
    "raos"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/amqplib": "^0.10.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@alicloud/docmind-api20220711": "^1.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@qdrant/qdrant-js": "^1.17.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.1.0",
    "amqplib": "^1.0.3",
    "basic-ftp": "^5.3.0",
    "better-sqlite3": "^12.8.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.1",
    "express-rate-limit": "^8.5.0",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "imap": "^0.8.19",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "ldapjs": "^3.0.7",
    "mammoth": "^1.12.0",
    "marked": "^17.0.4",
    "mqtt": "^5.15.1",
    "multer": "^2.1.1",
    "mysql2": "^3.22.0",
    "neo4j-driver": "^6.0.1",
    "nodemailer": "^8.0.5",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^4.0.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.39.1",
    "sharp": "^0.34.5",
    "soap": "^1.9.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
